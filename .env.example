# Redis Upstash (opsional, wajib di production untuk rate limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Salin file ini menjadi .env.local lalu isi dengan kredensial Supabase-mu.
# Ambil dari: Supabase Dashboard > Project Settings > API
# =============================================================================

# URL project Supabase, contoh: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key (aman dipakai di browser, dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (RAHASIA - HANYA untuk server, JANGAN pernah expose ke browser)
# Dipakai server untuk membuat akun user baru via Admin API.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string Postgres (Session pooler) untuk setup database lewat
# `npm run db:setup`. Ambil dari: Project Settings > Database > Connection string.
DATABASE_URL=

# Data seed admin pertama (RAHASIA - hanya untuk setup awal).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Identitas admin & sekolah contoh (opsional, ada nilai default di setup-db.mjs).
SEED_ADMIN_NAME=Administrator
SEED_SCHOOL_NAME=Sekolah Contoh
SEED_SCHOOL_SLUG=sekolah-contoh

# Path file .pem CA Supabase untuk verifikasi TLS (opsional).
# Kosongkan untuk menonaktifkan verifikasi TLS saat setup database.
DATABASE_CA_CERT=

# Nama aplikasi (opsional, tampil di UI)
NEXT_PUBLIC_APP_NAME=ERP Sekolah
